# Redis Cloud Configuration
# Copy your real values from https://app.redislabs.com/

REDIS_HOST=your-redis-host.cloud.redislabs.com
REDIS_PORT=your-port
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# CORS: comma-separated frontend origins allowed
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Kafka / Redpanda Configuration (optional)
# Set to "localhost:9092" to enable Kafka integration alongside Redis
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=pizza.orders

# Notes:
# - Use the public endpoint host and port from Redis Cloud
# - Keep your real credentials in backend/.env
